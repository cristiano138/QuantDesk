<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.quantdesk.watch">
    <!-- 版本号不在这里写死：唯一事实源是 android/build.py 的 VERSION_CODE 与 VERSION_NAME，
         由它注入构建目录里的这份清单，并在出包后回读 badging 断言。
         曾经清单自带旧值，构建参数被顶掉，出现「源码已经升到 1.3，装出来的包还是 1.2，
         老 App 比较 version_code 认为自己是最新，从此收不到任何更新」。 -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 新版本 APK 下载完要交给系统安装：Android 8 起这个权限是「能不能弹出安装页」的前置 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
        android:usesCleartextTraffic="false">
        <activity
            android:name="com.quantdesk.watch.MainActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 只递出刚下载好、且校验码核对过的那一个安装包（content://，不给 file:// 路径） -->
        <provider
            android:name="com.quantdesk.watch.UpdateFileProvider"
            android:authorities="com.quantdesk.watch.file"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
